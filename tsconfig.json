{
	"compilerOptions": {
		    "module": "esnext",
		    "moduleResolution": "bundler",
		"ignoreDeprecations": "6.0",
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"outDir": "./dist",
		"rootDir": "./src",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"jsx": "react-jsx",
		"types": ["node"]
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"],
	"exclude": ["node_modules", "dist"]
}
