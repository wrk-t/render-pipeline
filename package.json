{
	"name": "@wrk-t/render-pipeline",
	"version": "0.1.0",
	"description": "Metadata-driven client-side rendering pipeline for React/Next.js \u2014 blueprint registry, renderers, screen routing, dynamic forms and tables.",
	"license": "MIT",
	"author": "emadi68moh@gmail.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/wrk-t/render-pipeline"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"typesVersions": {
		"*": {
			"ui-components": [
				"./dist/ui-components/index.d.ts"
			],
			"ui-components/seed": [
				"./dist/ui-components/seed.d.ts"
			]
		}
	},
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./ui-components": {
			"import": "./dist/ui-components/index.js",
			"types": "./dist/ui-components/index.d.ts",
			"default": "./dist/ui-components/index.js"
		},
		"./ui-components/seed": {
			"import": "./dist/ui-components/seed.js",
			"types": "./dist/ui-components/seed.d.ts",
			"default": "./dist/ui-components/seed.js"
		},
		"./*": "./dist/*"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"clean": "rm -rf dist",
		"format": "npx @biomejs/biome format --write .",
		"lint": "npx @biomejs/biome lint --write .",
		"check": "npx @biomejs/biome check --write .",
		"hooks:install": "npx lefthook install",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"@casl/ability": "^6.8.1",
		"@casl/react": "^6.0.0",
		"@monaco-editor/react": "^4.7.0",
		"@nivo/bar": "^0.99.0",
		"@nivo/line": "^0.99.0",
		"@nivo/pie": "^0.99.0",
		"@tanstack/react-table": "8.20.6",
		"@uiw/react-color-colorful": "^2.10.3",
		"axios": "^1.15.2",
		"cn": "^0.5.2",
		"formik": "^2.4.9",
		"lucide-react": "1.73.0",
		"mapbox-gl": "^3.30.0",
		"monaco-editor": "^0.56.0",
		"next": "^16.2.4",
		"next-intl": "^4.11.0",
		"react-avatar-editor": "^15.1.0",
		"react-date-object": "^2.1.9",
		"react-fontpicker-ts": "^1.3.0",
		"react-multi-date-picker": "~4.4.1",
		"swr": "^2.4.1",
		"ts-pattern": "^5.9.0",
		"yup": "^1.7.1"
	},
	"peerDependencies": {
		"react": ">=18",
		"react-dom": ">=18",
		"sonner": ">=2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@types/node": "^25.9.1",
		"@types/react": "^19",
		"react": "^19.2.5",
		"react-dom": "^19.2.5",
		"sonner": "^2.0.8",
		"typescript": "^6.0.3"
	},
	"keywords": [
		"metadata",
		"render",
		"pipeline",
		"forms",
		"tables",
		"screens",
		"react",
		"nextjs"
	]
}
